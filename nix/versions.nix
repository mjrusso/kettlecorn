{ writeText, erlang, otp, elixirVersion, popcorn, wasi-libc, wasmtimeVersion, rustc, llvm, openssl, nixpkgs }:
let
  date = input:
    let d = input.lastModifiedDate; in
    "${builtins.substring 0 4 d}-${builtins.substring 4 2 d}-${builtins.substring 6 2 d}";
  pinned = input: "`${input.shortRev}` (${date input})";
  reqVersion = builtins.head (builtins.match
    ''.*"req": \{:hex, :req, "([^"]+)".*''
    (builtins.readFile ../guest/hex/mix.lock));
in
writeText "versions.md" ''
  <!-- versions: generated by `just docs-versions`; `nix flake check` fails when it's out of date -->
  | Component | Version | From |
  |---|---|---|
  | Erlang/OTP (guest) | ${otp.version} | flake input `otp` |
  | Erlang/OTP (host side) | ${erlang.version} | nixpkgs (`beamMinimal29Packages`) |
  | Elixir | ${elixirVersion} | flake input `elixir` |
  | Popcorn | ${pinned popcorn} | flake input `popcorn` (main) |
  | wasi-libc | ${pinned wasi-libc} | flake input `wasi-libc` |
  | wasmtime | ${wasmtimeVersion} | `rust/Cargo.toml` |
  | Rust (launcher) | ${rustc.version} | nixpkgs |
  | LLVM (clang, lld, compiler-rt) | ${llvm.release_version} | nixpkgs |
  | OpenSSL | ${openssl.version} | nixpkgs |
  | Req | ${reqVersion} | `guest/hex/mix.lock` |
  | nixpkgs | ${pinned nixpkgs} | flake input `nixpkgs` (nixos-unstable) |
  <!-- /versions -->
''
